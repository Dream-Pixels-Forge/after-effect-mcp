{
  "name": "after-effect-mcp",
  "version": "0.1.1",
  "description": "Local MCP server that lets MCP clients inspect and automate Adobe After Effects through ExtendScript.",
  "type": "module",
  "bin": {
    "after-effect-mcp": "./bin/after-effect-mcp.js"
  },
  "scripts": {
    "build": "tsc",
    "check:afterfx": "node ./scripts/check-afterfx-path.mjs",
    "install:clients": "node ./scripts/install-client-configs.mjs",
    "install:opencode": "node ./scripts/install-opencode-config.mjs",
    "test:live": "tsc && node ./scripts/live-ae-test.mjs",
    "smoke": "node ./scripts/smoke-test.mjs",
    "smoke:http": "node ./scripts/http-smoke-test.mjs",
    "test": "tsc && node ./scripts/check-afterfx-path.mjs && node ./scripts/smoke-test.mjs && node ./scripts/http-smoke-test.mjs",
    "start": "node ./build/index.js",
    "start:bridge": "node ./build/file-bridge.js",
    "start:http": "node ./build/http-bridge.js",
    "dev": "tsx ./src/index.ts",
    "dev:http": "tsx ./src/http-bridge.ts",
    "setup": "tsc && node ./build/index.js setup",
    "uninstall": "node ./build/index.js uninstall"
  },
  "files": [
    "assets",
    "bin",
    "build",
    "cep-extension",
    "examples",
    "scripts",
    "src",
    "LICENSE",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "codex",
    "opencode",
    "after-effects",
    "after-effects-scripting",
    "extendscript"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "tsx": "^4.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
