# After Effects MCP - Environment Variables Example
# Copy this file to .env and configure as needed

# After Effects executable path (optional, auto-detected if not set)
# AFTERFX_PATH=C:\Program Files\Adobe\Adobe After Effects 2024\Support Files\AfterFX.exe
# AFTER_EFFECTS_PATH=/Applications/Adobe After Effects 2024/AfterFX.app/Contents/MacOS/AfterFX

# Allowed directories for file operations (semicolon-separated paths)
# IMPORTANT: This is required for security - restricts file access to these directories
# MCP_ALLOWED_DIRS=C:\Projects\AfterEffects;C:\Assets\Footage
# MCP_ALLOWED_DIRS=/home/user/projects/after-effects;/home/user/assets

# Optional: Authentication token for stdio transport (Low severity - CVE-011)
# If set, clients must provide this token in the initialization
# MCP_AUTH_TOKEN=your-secret-token-here

# npm registry (already set in .npmrc)
# registry=https://registry.npmjs.org/
